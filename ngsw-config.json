{
  "index": "/index.html",
  "dataGroups": [
    {
      "name": "app-freshness",
      "urls": [
        "/resources/AllUsers/**",
        "/resources/AuthorProcedure/**",
        "/resources/MyDrafts/**",
        "/resources/Runs/MyRuns/**",
        "/resources/Runs/Run/**",
        "/resources/MyApprovals/**"
      ],
      "version": 1,
      "cacheConfig": {
        "maxSize": 10000,
        "maxAge": "30d",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "config",
      "urls": [
        "/assets/data/**"
      ],
      "version": 1,
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30d",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "**/**",
          "!/assets/data/**"
        ]
      }
    }
  ]
}
